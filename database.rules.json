{
  "rules": {
    "trips": {
      "$tripId": {
        ".read": true,
        "seats": {
          "$seatId": {
            ".write": true
          }
        }
      }
    },
    "bookings": {
      ".read": true,
      ".indexOn": ["passengerPhone"],
      "$bookingId": {
        ".write": true
      }
    }
  }
}
