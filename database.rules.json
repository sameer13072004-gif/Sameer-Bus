{
  "rules": {
    "trips": {
      "$tripId": {
        ".read": true,
        "seats": {
          "$seatId": {
            ".write": true
          }
        }
      }
    },
    "bookings": {
      ".read": true,
      ".indexOn": ["passengerPhone", "userId"],
      "$bookingId": {
        ".write": "!data.exists()",
        "boarded": {
          ".write": "root.child('bookings').child($bookingId).exists() && data.val() !== true && newData.val() === true"
        },
        "boardedAt": {
          ".write": "root.child('bookings').child($bookingId).exists() && newData.isNumber()"
        }
      }
    }
  }
}
